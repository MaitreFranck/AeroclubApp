<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.MembresController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Gestion des Membres" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Rafraîchir" onAction="#loadMembres" />
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Rechercher par nom ou licence..." prefWidth="250" />

        <ComboBox fx:id="filterCombo" promptText="Filtrer par état" prefWidth="150" />

        <Separator orientation="VERTICAL" />

        <Button text="+ Nouveau Membre" onAction="#handleAddMembre"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Modifier" onAction="#handleEditMembre" />
        <Button text="Valider Compte" onAction="#handleValiderCompte"
                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
        <Button text="Supprimer" onAction="#handleDeleteMembre"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </HBox>

    <TableView fx:id="membresTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="100"/>
            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="100"/>
            <TableColumn fx:id="colLicence" text="N° Licence" prefWidth="100"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="90"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="80"/>
            <TableColumn fx:id="colEtat" text="État" prefWidth="90"/>
            <TableColumn fx:id="colSolde" text="Solde" prefWidth="80"/>
            <TableColumn fx:id="colDroits" text="Droits" prefWidth="110"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>