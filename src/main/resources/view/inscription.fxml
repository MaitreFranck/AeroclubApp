<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.InscriptionController">
    <VBox alignment="CENTER" spacing="12.0" prefWidth="450.0">
        <padding>
            <Insets bottom="20.0" left="30.0" right="30.0" top="20.0"/>
        </padding>

        <Label text="Inscription Aéroclub">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="40.0" />
                <ColumnConstraints percentWidth="60.0" />
            </columnConstraints>

            <Label text="Nom :" GridPane.rowIndex="0" />
            <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Prénom :" GridPane.rowIndex="1" />
            <TextField fx:id="prenomField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Email :" GridPane.rowIndex="2" />
            <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <Label text="Téléphone :" GridPane.rowIndex="3" />
            <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <Label text="Date de naissance :" GridPane.rowIndex="4" />
            <DatePicker fx:id="dateNaisPicker" GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="Infinity" />

            <Label text="Mot de passe :" GridPane.rowIndex="5" />
            <PasswordField fx:id="passwordField" GridPane.rowIndex="5" GridPane.columnIndex="1" />
        </GridPane>

        <Button text="S'inscrire" onAction="#handleInscription" prefWidth="Infinity"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />

        <Button text="Retour à la connexion" onAction="#handleRetour" prefWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #2196F3; -fx-cursor: hand;" />

        <Label fx:id="messageLabel" wrapText="true" />
    </VBox>
</ScrollPane>