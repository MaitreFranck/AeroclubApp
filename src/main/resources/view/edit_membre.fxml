<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" prefHeight="650" prefWidth="500" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.EditMembreController">
    <VBox spacing="15" style="-fx-background-color: #f4f7f6;">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

        <Label text="Informations Membre" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Separator/>

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints prefWidth="120" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Nom :" GridPane.rowIndex="0" />
            <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Prénom :" GridPane.rowIndex="1" />
            <TextField fx:id="prenomField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Email :" GridPane.rowIndex="2" />
            <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Téléphone :" GridPane.rowIndex="3" />
            <TextField fx:id="telField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Mot de passe :" GridPane.rowIndex="4" />
            <PasswordField fx:id="passwordField" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="Requis pour nouveau / Optionnel pour modif"/>

            <Label text="Date Naissance :" GridPane.rowIndex="5" />
            <DatePicker fx:id="dateNaissancePicker" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>

            <Label text="N° Licence :" GridPane.rowIndex="6" />
            <TextField fx:id="licenceField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <Label text="Type Membre :" GridPane.rowIndex="7" />
            <ComboBox fx:id="typeCombo" GridPane.rowIndex="7" GridPane.columnIndex="1" maxWidth="Infinity"/>

            <Label text="Statut :" GridPane.rowIndex="8" />
            <ComboBox fx:id="statutCombo" GridPane.rowIndex="8" GridPane.columnIndex="1" maxWidth="Infinity"/>

            <Label text="Droits :" GridPane.rowIndex="9" />
            <ComboBox fx:id="droitsCombo" GridPane.rowIndex="9" GridPane.columnIndex="1" maxWidth="Infinity"/>

            <Label text="État validation :" GridPane.rowIndex="10" />
            <ComboBox fx:id="etatCombo" GridPane.rowIndex="10" GridPane.columnIndex="1" maxWidth="Infinity"/>

            <Label text="Solde (€) :" GridPane.rowIndex="11" />
            <Spinner fx:id="soldeSpinner" GridPane.rowIndex="11" GridPane.columnIndex="1" maxWidth="Infinity" editable="true"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Annuler" onAction="#handleCancel" />
            <Button text="Enregistrer" onAction="#handleSave" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</ScrollPane>