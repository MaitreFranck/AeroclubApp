<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="mainPane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.DashboardController" prefHeight="600.0" prefWidth="1000.0">
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-min-width: 200;">
            <padding><Insets top="20" right="10" bottom="20" left="10"/></padding>
            <Label text="AÉROCLUB" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20;"/>
            <Separator/>
            <Button text="Gestion des Avions" onAction="#showAvionsPage" maxWidth="Infinity" style="-fx-cursor: hand;"/>
            <Button text="Liste des Membres" onAction="#showMembresPage" maxWidth="Infinity" style="-fx-cursor: hand;"/>
            <Button text="Planning / Réservations" onAction="#showReservationsPage" maxWidth="Infinity" style="-fx-cursor: hand;"/>
            <Button text="Historique des Vols" onAction="#showVolsPage" maxWidth="Infinity" style="-fx-cursor: hand;"/>
            <Button text="Comptabilité / Opérations" onAction="#showOperationsPage" maxWidth="Infinity" style="-fx-cursor: hand;"/>
            <Button text="Cotisations" onAction="#showCotisationsPage" maxWidth="Infinity" style="-fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS" />
            <Button text="Déconnexion" fx:id="logoutBtn" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label text="Bienvenue sur le tableau de bord" style="-fx-font-size: 24;"/>
            <Label fx:id="welcomeLabel" text="Sélectionnez une option dans le menu latéral" style="-fx-text-fill: gray;"/>
        </VBox>
    </center>
</BorderPane>