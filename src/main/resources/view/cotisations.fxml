<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CotisationsController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Suivi des Cotisations Annuelles" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Saisir un paiement" onAction="#handleOpenSaisie"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Actualiser" onAction="#loadData"/>
    </HBox>

    <TableView fx:id="cotisationsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colMembre" text="Membre" prefWidth="200"/>
            <TableColumn fx:id="colAnnee" text="Année" prefWidth="100"/>
            <TableColumn fx:id="colDate" text="Date de Paiement" prefWidth="180"/>
            <TableColumn fx:id="colMontant" text="Montant (€)" prefWidth="120"/>
        </columns>
    </TableView>
</VBox>