<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" prefWidth="400" xmlns="http://javafx.com/javafx" xmlns:fx="http://fxml" fx:controller="controller.EditOperationController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Nouvelle Opération" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Membre :" GridPane.rowIndex="0" />
        <ComboBox fx:id="membreCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Type :" GridPane.rowIndex="1" />
        <ComboBox fx:id="typeCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Mode :" GridPane.rowIndex="2" />
        <ComboBox fx:id="modeCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Montant (€) :" GridPane.rowIndex="3" />
        <TextField fx:id="montantField" GridPane.rowIndex="3" GridPane.columnIndex="1" />
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleCancel" />
        <Button text="Enregistrer" onAction="#handleSave" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
    </HBox>
</VBox>